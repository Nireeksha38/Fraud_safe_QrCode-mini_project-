{
  "expo": {
    "name": "FraudSafe QR",
    "slug": "fraudsafe-qr-app",
    "scheme": "fraudsafe-qr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "FraudSafe QR needs access to your camera to scan payment QR codes.",
        "NSFaceIDUsageDescription": "FraudSafe QR uses Face ID for secure payment authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FraudSafe QR to access camera for fraud-safe QR scanning."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FraudSafe QR to authenticate using biometric sensors."
        }
      ]
    ]
  }
}
